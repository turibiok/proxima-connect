# Chaine de connexion PostgreSQL (Neon : utiliser l'URL "pooled", sslmode=verify-full)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=verify-full

# Premier compte administrateur, cree par `npm run semer`
ADMIN_EMAIL=admin@proxima.bj
ADMIN_MOT_DE_PASSE=

# ---------------------------------------------------------------- phase 3
# Adresse publique du site, pour les liens des messages envoyes par les
# taches planifiees (sans requete entrante). Facultatif sur Vercel.
APP_URL=

# Secret du planificateur (Vercel Cron) : sans lui, /api/taches refuse tout.
CRON_SECRET=

# Envoi automatique des messages : aucun (defaut), simulation (essais), twilio
COMMUNICATION_FOURNISSEUR=aucun
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
